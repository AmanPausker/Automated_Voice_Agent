# Meta WhatsApp Business Platform Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
WHATSAPP_BOOKING_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Current deployment is one centrally configured tenant.
WHATSAPP_TENANT_ID=default
WHATSAPP_HOSPITAL_NAME=
WHATSAPP_DOCTOR_NAME=
WHATSAPP_SPECIALIZATION=
WHATSAPP_HOSPITAL_ADDRESS=
WHATSAPP_HOSPITAL_PHONE=
# Scheduling Engine Provider: 'google' | 'calcom' (default is 'calcom')
SCHEDULING_PROVIDER=calcom

# Google Calendar OAuth 2.0 (per-doctor personal Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Clinic Timings & Slot Seeding Rules
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_WORKING_DAYS=[1,2,3,4,5,6]
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=18:00
CLINIC_BREAK_WINDOWS=[{"start":"13:00","end":"14:00"}]
CLINIC_HOLIDAYS=[]
SLOT_SEED_WINDOW_DAYS=30

# Google Calendar Event Colors (1-11, 2 = Sage / Green for Available slots)
GOOGLE_SLOT_COLOR_ID=2
GOOGLE_APPOINTMENT_COLOR_IDS={}
GOOGLE_WEBHOOK_BASE_URL=https://your-domain.ngrok-free.app

# Speech-to-Text & Text-to-Speech Engine Providers
# STT_PROVIDER: 'sarvam' (Saaras) | 'deepgram' (Nova-2)
STT_PROVIDER=sarvam
# TTS_PROVIDER: 'sarvam' (Bulbul) | 'cartesia' (Sonic) | 'openai'
TTS_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_VOICE_ID=anushka
